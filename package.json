{
  "name": "chatui",
  "version": "1.0.0",
  "private": true,
  "description": "纯前端、零后端、零账号的 OpenAI 兼容协议聊天界面。数据（对话、设置、API Key、长期记忆）全部保存在浏览器 localStorage 中。",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./assets/css/app.css --minify",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./assets/css/app.css --watch"
  },
  "keywords": [
    "chat",
    "openai",
    "ollama",
    "tailwindcss"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
